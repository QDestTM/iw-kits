{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},

	"MongoDB" : {
		"AuthSource" : "admin",
		"MaxPoolSize" : 256,

		"Databases" : {
			"Data" : "iwkits_data",
			"Auth" : "iwkits_auth",
			"Core" : "iwkits_core"
		}
	},

	"Security" : {
		"JwtIssuer" : "iw-kits-api",
		"JwtAudience" : "iw-kits-web"
	},

	"Session" : {
		"AccessPeriod" : 25,
		"RefreshPeriod" : 23040
	},

	"Constraints" : {
		"ImportChunkSize" : 128,
		"RespondMaxPageSize" : 128
	},

	"Services" : {
		"TaxApplier" : "default",
		"OrderProcess" : "default",
		"GeoLocation" : "default"
	},

	"AllowedHosts": "*"
}
