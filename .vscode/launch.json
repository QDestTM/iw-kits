{
	"version": "0.2.0",

	"configurations": [
		{
			"name": "Start Api",
			"type": "coreclr",

			"console": "internalConsole",
			"stopAtEntry": false,
			"request": "launch",

			"internalConsoleOptions": "openOnSessionStart",
			"preLaunchTask": "build-api",
			"args": [],

			"env" : {
				"ASPNETCORE_ENVIRONMENT" : "Development"
			},

			"program": "${config:iwkits.apiPath}/bin/Debug/net10.0/IWKits.Api.dll",
			"cwd": "${workspaceFolder}"
		},
	]
}